<?xml version="1.0" encoding="utf-8"?>
<!-- The console's top panel: dark brushed gunmetal, textured, riveted at the
     bottom corners like a bolted metal plate, trimmed with a brass edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="20dp" android:bottomRightRadius="20dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/gradient_start"
                android:centerColor="@color/gradient_mid"
                android:endColor="@color/gradient_end" />
        </shape>
    </item>
    <!-- brushed streaks, inset short of the bottom curve so a plain rectangular
         bitmap layer never pokes past the rounded corners underneath -->
    <item android:bottom="22dp">
        <bitmap android:src="@drawable/tex_brushed_dark" android:tileModeX="repeat" android:tileModeY="repeat" android:gravity="fill" />
    </item>
    <item android:gravity="top|end" android:width="160dp" android:height="160dp" android:top="-70dp" android:end="-60dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
    <!-- brass trim line along the very bottom edge -->
    <item android:gravity="bottom" android:height="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
        </shape>
    </item>
    <!-- corner rivets - inset well inside the 20dp curve so they sit on solid paint -->
    <item android:gravity="bottom|start" android:width="18dp" android:height="18dp" android:bottom="10dp" android:start="14dp">
        <bitmap android:src="@drawable/ic_rivet_dark" android:gravity="fill" />
    </item>
    <item android:gravity="bottom|end" android:width="18dp" android:height="18dp" android:bottom="10dp" android:end="14dp">
        <bitmap android:src="@drawable/ic_rivet_dark" android:gravity="fill" />
    </item>
</layer-list>
