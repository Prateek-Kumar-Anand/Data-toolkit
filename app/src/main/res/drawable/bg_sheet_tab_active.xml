<?xml version="1.0" encoding="utf-8"?>
<!-- The selected sheet tab in the Excel/CSV grid's sheet-tab row - same tinted-fill-plus-border
     shape as bg_chip_outline, but in this module's own accent_excel green rather than the
     app-wide primary indigo, matching accent_excel_bg's use elsewhere on this screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/accent_excel_bg" />
    <stroke android:width="1.2dp" android:color="@color/accent_excel" />
    <corners android:radius="14dp" />
</shape>
