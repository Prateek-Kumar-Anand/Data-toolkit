<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_flat"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="26dp" android:paddingBottom="22dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/web_scraping_web_scraping" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="@string/web_scraping_auto_detects_fields_and" android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <EditText android:importantForAutofill="no"
                        android:id="@+id/etUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="1"
                        android:maxLines="5"
                        android:background="@drawable/bg_input_field_focused"
                        android:hint="@string/web_scraping_https_example_com_one"
                        android:textColorHint="@color/text_secondary"
                        android:inputType="textUri|textMultiLine" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScrape"
                        style="@style/Widget.App.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/web_scraping_scrape_page_s" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:progressTint="@color/primary"
                        android:max="100"
                        android:visibility="gone" />

                    <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:textColor="@color/text_secondary" android:textSize="12.5sp" />

                    <TextView android:id="@+id/tvItemCount" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:textColor="@color/primary" android:textStyle="bold" android:textSize="13sp" />

                    <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:textStyle="bold" android:textColor="@color/text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Custom scraping: optional manual CSS selectors, used instead of auto-detection
                 when a "Container selector" is provided. Any field left blank still falls back
                 to auto-detection for that one field. -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/web_scraping_custom_scraping_optional" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="@string/web_scraping_fill_in_a_container"
                        android:textColor="@color/text_secondary" android:textSize="11.5sp" />

                    <EditText android:inputType="text" android:importantForAutofill="no" android:id="@+id/etContainerSelector"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_field_focused" android:padding="10dp" android:textSize="13sp"
                        android:hint="@string/web_scraping_container_selector_e_g" android:singleLine="true" android:fontFamily="monospace" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <EditText android:inputType="text" android:importantForAutofill="no" android:id="@+id/etTitleSelector" android:hint="@string/web_scraping_title_selector"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_input_field_focused" android:padding="10dp" android:textSize="12.5sp" android:singleLine="true" android:fontFamily="monospace" />
                        <EditText android:inputType="text" android:importantForAutofill="no" android:id="@+id/etPriceSelector" android:hint="@string/web_scraping_price_selector"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp"
                            android:background="@drawable/bg_input_field_focused" android:padding="10dp" android:textSize="12.5sp" android:singleLine="true" android:fontFamily="monospace" />
                    </LinearLayout>

                    <EditText android:inputType="text" android:importantForAutofill="no" android:id="@+id/etDescriptionSelector" android:hint="@string/web_scraping_description_selector"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field_focused" android:padding="10dp" android:textSize="12.5sp" android:singleLine="true" android:fontFamily="monospace" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <EditText android:inputType="text" android:importantForAutofill="no" android:id="@+id/etImageSelector" android:hint="@string/web_scraping_image_selector"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_input_field_focused" android:padding="10dp" android:textSize="12.5sp" android:singleLine="true" android:fontFamily="monospace" />
                        <EditText android:inputType="text" android:importantForAutofill="no" android:id="@+id/etLinkSelector" android:hint="@string/web_scraping_link_selector"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp"
                            android:background="@drawable/bg_input_field_focused" android:padding="10dp" android:textSize="12.5sp" android:singleLine="true" android:fontFamily="monospace" />
                    </LinearLayout>

                    <EditText android:inputType="text" android:importantForAutofill="no" android:id="@+id/etUserAgent"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_field" android:padding="10dp" android:textSize="11.5sp"
                        android:hint="@string/web_scraping_custom_user_agent_optional" android:singleLine="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/web_scraping_extracted_text" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    <EditText android:importantForAutofill="no"
                        android:id="@+id/etText"
                        android:layout_width="match_parent"
                        android:layout_height="340dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_field_focused"
                        android:gravity="top|start"
                        android:textSize="13sp"
                        android:inputType="textMultiLine" 
                        android:scrollbars="vertical"
                        android:overScrollMode="always"
                        android:scrollbarStyle="insideInset"
                        android:fadeScrollbars="false"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="@string/web_scraping_links_tables_found" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    <TextView
                        android:id="@+id/tvLinks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="80dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="monospace"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/web_scraping_preview_scraped_data_before" android:textAppearance="@style/TextAppearance.App.SectionTitle" />

                    <TextView
                        android:id="@+id/tvItemsEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/web_scraping_no_structured_product_article"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />

                    <LinearLayout
                        android:id="@+id/itemsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveXlsx"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:enabled="false"
                android:text="@string/web_scraping_save_xlsx" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/web_scraping_save_txt" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
