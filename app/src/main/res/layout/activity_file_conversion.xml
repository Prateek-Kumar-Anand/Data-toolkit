<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_flat"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="26dp" android:paddingBottom="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔁  File Conversion" android:textColor="@color/text_on_primary" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="Documents, images and audio — convert between formats, on-device" android:textColor="@color/text_on_primary_muted" android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="1. Choose a file" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickFile"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Pick any document, image, audio or video file" />
                    <TextView android:id="@+id/tvSourceInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:textColor="@color/text_secondary" android:textSize="12.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="2. Pick a target format" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    <Spinner android:id="@+id/spinnerTargetFormat" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:background="@drawable/bg_input_field" android:popupBackground="@drawable/bg_input_field" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConvert"
                        style="@style/Widget.App.Button.Primary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:enabled="false"
                        android:text="🔁  Convert" />
                    <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:textColor="@color/text_secondary" android:textSize="12.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveAs"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:enabled="false"
                android:text="💾  Save Converted File As…" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Notes: document conversion carries over text only (no fonts/layout). Video is limited to extracting the audio track as .m4a — full video re-encoding isn't supported on-device."
                android:textColor="@color/text_secondary" android:textSize="11.5sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
