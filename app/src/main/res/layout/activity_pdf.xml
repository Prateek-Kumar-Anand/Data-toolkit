<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_flat"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="26dp" android:paddingBottom="22dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/pdf_pdf_operations" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="@string/pdf_merge_split_extract_text" android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Extract Text -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/accent_pdf_bg">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/pdf_symbol" android:textSize="17sp" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pdf_extract_text" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/pdf_pull_all_readable_text" android:textAppearance="@style/TextAppearance.App.Body" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExtractText"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/pdf_choose_a_pdf" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Merge PDFs -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/accent_pdf_bg">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/pdf_symbol_2" android:textSize="17sp" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pdf_merge_pdfs" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/pdf_combine_two_or_more" android:textAppearance="@style/TextAppearance.App.Body" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMerge"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/pdf_choose_pdfs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Split PDF -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/accent_pdf_bg">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/pdf_symbol_3" android:textSize="17sp" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pdf_split_pdf" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/pdf_pull_out_a_page" android:textAppearance="@style/TextAppearance.App.Body" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                        <EditText android:importantForAutofill="no" android:id="@+id/etStartPage" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:background="@drawable/bg_input_field_focused" android:hint="@string/pdf_start_page" android:textColorHint="@color/text_secondary"
                            android:gravity="center" android:inputType="number" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                            android:text="@string/pdf_symbol_4" android:textColor="@color/text_secondary" android:textSize="16sp" />
                        <EditText android:importantForAutofill="no" android:id="@+id/etEndPage" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:background="@drawable/bg_input_field_focused" android:hint="@string/pdf_end_page" android:textColorHint="@color/text_secondary"
                            android:gravity="center" android:inputType="number" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSplit"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/pdf_choose_a_pdf" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Images -> PDF -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/accent_pdf_bg">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/pdf_symbol_5" android:textSize="17sp" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pdf_images_pdf" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/pdf_one_page_per_picture" android:textAppearance="@style/TextAppearance.App.Body" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImagesToPdf"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/pdf_choose_images" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:progressTint="@color/accent_pdf"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" android:textSize="12.5sp" android:layout_marginBottom="10dp" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/accent_pdf_bg">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/dashboard_symbol_3" android:textSize="17sp" />
                        </FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
                            android:text="@string/pdf_result" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    </LinearLayout>
                    <EditText android:importantForAutofill="no"
                        android:id="@+id/etOutput"
                        android:layout_width="match_parent"
                        android:layout_height="340dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_input_field_focused"
                        android:gravity="top|start"
                        android:hint="@string/pdf_your_result_will_appear"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="13sp"
                        android:inputType="textMultiLine" 
                        android:scrollbars="vertical"
                        android:overScrollMode="always"
                        android:scrollbarStyle="insideInset"
                        android:fadeScrollbars="false"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveAs"
                        style="@style/Widget.App.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/pdf_save_last_result" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
