<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_flat"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="26dp" android:paddingBottom="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📄  PDF Operations" android:textColor="@color/text_on_primary" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="Merge, split, extract text, build from images" android:textColor="@color/text_on_primary_muted" android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Extract Text" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExtractText"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Pick a PDF and extract text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Merge PDFs" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMerge"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Pick 2+ PDFs to merge" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Split PDF" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                        <EditText android:id="@+id/etStartPage" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:background="@drawable/bg_input_field_focused" android:hint="Start page" android:textColorHint="@color/text_secondary" android:inputType="number" android:layout_marginEnd="6dp" />
                        <EditText android:id="@+id/etEndPage" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:background="@drawable/bg_input_field_focused" android:hint="End page" android:textColorHint="@color/text_secondary" android:inputType="number" android:layout_marginStart="6dp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSplit"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Pick a PDF and split range" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Images → PDF" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImagesToPdf"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Pick images to combine into a PDF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" android:textSize="12.5sp" android:layout_marginBottom="10dp" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Result" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    <EditText
                        android:id="@+id/etOutput"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_field_focused"
                        android:gravity="top|start"
                        android:textSize="13sp"
                        android:inputType="textMultiLine" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveAs"
                        style="@style/Widget.App.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="💾  Save Last Result As…" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
