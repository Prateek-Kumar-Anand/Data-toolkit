<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_flat"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="26dp" android:paddingBottom="22dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/invoice_ocr_invoice_receipt_ocr" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="@string/invoice_ocr_scan_invoices_receipts_invoice" android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: capture + OCR progress -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCamera"
                            style="@style/Widget.App.Button.Compact"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="@string/invoice_ocr_camera" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGallery"
                            style="@style/Widget.App.Button.Compact.Outlined"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="@string/invoice_ocr_gallery" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBatchPick"
                        style="@style/Widget.App.Button.Compact.Outlined"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/invoice_ocr_batch_scan_pick_several" />

                    <ImageView android:contentDescription="@string/cd_preview_image"
                        android:id="@+id/ivPreview"
                        android:layout_width="match_parent" android:layout_height="180dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_input_field"
                        android:scaleType="centerInside" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:progressTint="@color/accent_invoice"
                        android:max="100"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/text_secondary" android:textSize="12.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: parsed fields (editable - OCR/heuristic extraction, always user-verifiable) -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/invoice_ocr_detected_fields_edit_anything" android:textAppearance="@style/TextAppearance.App.Eyebrow" />

                    <EditText android:inputType="text" android:importantForAutofill="no" android:id="@+id/etCompany" android:hint="@string/invoice_ocr_company_vendor"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_field_focused" android:padding="10dp" android:textSize="13sp" android:singleLine="true" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <EditText android:inputType="text" android:importantForAutofill="no" android:id="@+id/etInvoiceNumber" android:hint="@string/invoice_ocr_invoice"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_input_field_focused" android:padding="10dp" android:textSize="13sp" android:singleLine="true" />
                        <EditText android:inputType="text" android:importantForAutofill="no" android:id="@+id/etDate" android:hint="@string/invoice_ocr_date"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp"
                            android:background="@drawable/bg_input_field_focused" android:padding="10dp" android:textSize="13sp" android:singleLine="true" />
                    </LinearLayout>

                    <EditText android:inputType="text" android:importantForAutofill="no" android:id="@+id/etCustomer" android:hint="@string/invoice_ocr_customer_bill_to"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field_focused" android:padding="10dp" android:textSize="13sp" android:singleLine="true" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="@string/invoice_ocr_items_one_per_line" android:textColor="@color/text_secondary" android:textSize="11.5sp" />
                    <EditText android:importantForAutofill="no" android:id="@+id/etItems"
                        android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_field_focused" android:padding="10dp" android:textSize="12.5sp"
                        android:gravity="top|start" android:inputType="textMultiLine" 
                        android:scrollbars="vertical"
                        android:overScrollMode="always"
                        android:scrollbarStyle="insideInset"
                        android:fadeScrollbars="false"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <EditText android:importantForAutofill="no" android:id="@+id/etSubtotal" android:hint="@string/invoice_ocr_subtotal"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_input_field_focused" android:padding="10dp" android:textSize="13sp" android:singleLine="true" android:inputType="numberDecimal" />
                        <EditText android:importantForAutofill="no" android:id="@+id/etTax" android:hint="@string/invoice_ocr_tax"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_input_field_focused" android:padding="10dp" android:textSize="13sp" android:singleLine="true" android:inputType="numberDecimal" />
                        <EditText android:importantForAutofill="no" android:id="@+id/etTotal" android:hint="@string/invoice_ocr_total"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp"
                            android:background="@drawable/bg_input_field_focused" android:padding="10dp" android:textSize="13sp" android:singleLine="true" android:inputType="numberDecimal" />
                    </LinearLayout>

                    <TextView android:id="@+id/tvExtraFieldsLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                        android:text="@string/invoice_ocr_other_detected_fields" android:textAppearance="@style/TextAppearance.App.Eyebrow"
                        android:visibility="gone" />

                    <LinearLayout android:id="@+id/extraFieldsContainer"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddToBatch"
                        style="@style/Widget.App.Button.Compact"
                        android:backgroundTint="@color/accent_invoice"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:enabled="false"
                        android:text="@string/invoice_ocr_add_to_batch" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: this session's batch + export -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/invoice_ocr_this_session_s_batch" android:textAppearance="@style/TextAppearance.App.Eyebrow" />

                    <TextView android:id="@+id/tvBatchEmptyState"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="@string/invoice_ocr_no_invoices_added_yet"
                        android:textColor="@color/text_secondary" android:textSize="12.5sp" />

                    <LinearLayout android:id="@+id/batchContainer"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportCsv"
                            style="@style/Widget.App.Button.Compact.Outlined"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp"
                            android:enabled="false" android:text="@string/invoice_ocr_export_csv" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportXlsx"
                            style="@style/Widget.App.Button.Compact"
                            android:backgroundTint="@color/accent_invoice"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp"
                            android:enabled="false" android:text="@string/invoice_ocr_export_excel" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: history -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/invoice_ocr_recent_activity" android:textAppearance="@style/TextAppearance.App.Eyebrow" />
                    <TextView android:id="@+id/tvHistoryEmptyState"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="@string/invoice_ocr_no_invoices_processed_yet"
                        android:textColor="@color/text_secondary" android:textSize="12.5sp" />
                    <LinearLayout android:id="@+id/historyContainer"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
