<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_flat"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="26dp" android:paddingBottom="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🧹  Data Cleaning" android:textColor="@color/text_on_primary" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="Upload CSV/Excel/JSON/TXT, or paste rows directly" android:textColor="@color/text_on_primary_muted" android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload a file or paste rows below"
                        android:textAppearance="@style/TextAppearance.App.SectionTitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadFile"
                        style="@style/Widget.App.Button.Compact.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="📁  Upload File (.csv .xlsx .json .txt)" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:progressTint="@color/primary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvColumnsPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:minHeight="40dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="monospace"
                        android:textSize="11.5sp" />

                    <EditText
                        android:id="@+id/etInput"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_field_focused"
                        android:gravity="top|start"
                        android:hint="name,email,city&#10;Asha, asha@mail.com , Delhi&#10;Asha, asha@mail.com , Delhi"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="13.5sp"
                        android:inputType="textMultiLine" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                        <CheckBox android:id="@+id/cbTrim" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Trim whitespace" android:checked="true" android:buttonTint="@color/primary" />
                        <CheckBox android:id="@+id/cbCollapse" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Collapse inner spaces" android:checked="true" android:buttonTint="@color/primary" />
                        <CheckBox android:id="@+id/cbDedupe" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Remove duplicate rows" android:checked="true" android:buttonTint="@color/primary" />
                        <CheckBox android:id="@+id/cbEmptyRows" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Remove empty rows" android:checked="true" android:buttonTint="@color/primary" />
                        <CheckBox android:id="@+id/cbUnwantedChars" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Remove unwanted characters" android:checked="false" android:buttonTint="@color/primary" />
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="Case standardization (global)" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    <Spinner android:id="@+id/spinnerCaseMode" android:layout_width="match_parent" android:layout_height="wrap_content" />

                    <EditText
                        android:id="@+id/etFillMissing"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:background="@drawable/bg_input_field"
                        android:hint="Fill blank cells with (optional, e.g. N/A)" android:textSize="13sp"
                        android:inputType="text" />

                    <CheckBox android:id="@+id/cbFuzzyDedupe" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Fuzzy match when de-duplicating (ignore case/spacing)"
                        android:buttonTint="@color/primary" />

                    <EditText
                        android:id="@+id/etDedupeKeys"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:background="@drawable/bg_input_field"
                        android:hint="Dedupe by columns (comma-separated, blank = whole row)" android:textSize="13sp"
                        android:inputType="text" />

                    <CheckBox android:id="@+id/cbFlagInvalid" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:checked="true"
                        android:text="Flag invalid values (auto-detect email/phone/number/date)"
                        android:buttonTint="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClean"
                        style="@style/Widget.App.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="✨ Clean Data" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Per-column rules (optional)"
                        android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Override the global settings above for specific columns"
                        android:textSize="11.5sp"
                        android:textColor="@color/text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetectColumns"
                        style="@style/Widget.App.Button.Compact.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="🔍 Detect Columns" />

                    <LinearLayout
                        android:id="@+id/columnRulesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Find &amp; replace rules (optional)"
                        android:textAppearance="@style/TextAppearance.App.SectionTitle" />

                    <LinearLayout
                        android:id="@+id/replaceRulesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddReplaceRule"
                        style="@style/Widget.App.Button.Compact.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="+ Add Rule" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp"
                android:lineSpacingExtra="3dp" />

            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cleaned output"
                        android:textAppearance="@style/TextAppearance.App.SectionTitle" />

                    <EditText
                        android:id="@+id/etOutput"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_field_focused"
                        android:fontFamily="monospace"
                        android:gravity="top|start"
                        android:textSize="12.5sp"
                        android:inputType="textMultiLine" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Export as"
                        android:textAppearance="@style/TextAppearance.App.SectionTitle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportCsv"
                            style="@style/Widget.App.Button.Compact.Outlined"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginEnd="4dp" android:enabled="false"
                            android:text="CSV" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportXlsx"
                            style="@style/Widget.App.Button.Compact.Outlined"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:enabled="false"
                            android:text="XLSX" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportJson"
                            style="@style/Widget.App.Button.Compact.Outlined"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:enabled="false"
                            android:text="JSON" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportTxt"
                            style="@style/Widget.App.Button.Compact.Outlined"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="4dp" android:enabled="false"
                            android:text="TXT" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
