<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:tools="http://schemas.android.com/tools" tools:ignore="TooManyViews" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero header, matching the icon-chip treatment used on the dashboard -->
        <LinearLayout android:baselineAligned="false" android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_flat"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="26dp" android:paddingBottom="24dp">
            <FrameLayout android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_icon_chip_on_primary">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/data_cleaning_symbol" android:textSize="24sp" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/data_cleaning_data_cleaning" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                    android:text="@string/data_cleaning_upload_csv_excel_json" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- STEP 1 — Add your data -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/data_cleaning_step" android:textAppearance="@style/TextAppearance.App.Eyebrow" android:layout_marginBottom="6dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_chip">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/data_cleaning_symbol_2" android:textSize="17sp" />
                        </FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
                            android:text="@string/data_cleaning_add_your_data" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    </LinearLayout>

                    <!-- Upload "dropzone" - keeps the id/click target Kotlin already listens on -->
                    <LinearLayout
                        android:id="@+id/btnUploadFile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_input_field"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp">
                        <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_chip">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/data_cleaning_symbol_3" android:textSize="19sp" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                            android:text="@string/data_cleaning_tap_to_upload_a" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="14.5sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:text="@string/data_cleaning_csv_xlsx_json_txt" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:progressTint="@color/primary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvColumnsPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="36dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <!-- "or paste rows" divider -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                        android:gravity="center_vertical" android:layout_marginTop="16dp">
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/stroke" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                            android:text="@string/data_cleaning_or_paste_rows_below" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.06" />
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/stroke" />
                    </LinearLayout>

                    <EditText android:importantForAutofill="no"
                        android:id="@+id/etInput"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_input_field_focused"
                        android:gravity="top|start"
                        android:hint="@string/data_cleaning_name_email_city_asha"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="13.5sp"
                        android:inputType="textMultiLine" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STEP 2 — Cleaning options -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/data_cleaning_step_2" android:textAppearance="@style/TextAppearance.App.Eyebrow" android:layout_marginBottom="6dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_chip">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/data_cleaning_symbol_4" android:textSize="17sp" />
                        </FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
                            android:text="@string/data_cleaning_cleaning_options" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    </LinearLayout>

                    <!-- Toggle rows: title + caption on the left, switch-style checkbox on the right -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="12dp" android:paddingBottom="10dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/data_cleaning_trim_whitespace" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/data_cleaning_removes_leading_trailing_spaces" android:textColor="@color/text_secondary" android:textSize="11.5sp" />
                        </LinearLayout>
                        <CheckBox android:id="@+id/cbTrim" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:checked="true" android:button="@drawable/checkbox_bevel" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="10dp" android:paddingBottom="10dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/data_cleaning_collapse_inner_spaces" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/data_cleaning_turns_double_spaces_into" android:textColor="@color/text_secondary" android:textSize="11.5sp" />
                        </LinearLayout>
                        <CheckBox android:id="@+id/cbCollapse" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:checked="true" android:button="@drawable/checkbox_bevel" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="10dp" android:paddingBottom="10dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/data_cleaning_remove_duplicate_rows" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/data_cleaning_keeps_the_first_occurrence" android:textColor="@color/text_secondary" android:textSize="11.5sp" />
                        </LinearLayout>
                        <CheckBox android:id="@+id/cbDedupe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:checked="true" android:button="@drawable/checkbox_bevel" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="10dp" android:paddingBottom="10dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/data_cleaning_remove_empty_rows" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/data_cleaning_drops_rows_that_are" android:textColor="@color/text_secondary" android:textSize="11.5sp" />
                        </LinearLayout>
                        <CheckBox android:id="@+id/cbEmptyRows" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:checked="true" android:button="@drawable/checkbox_bevel" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="10dp" android:paddingBottom="10dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/data_cleaning_remove_unwanted_characters" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/data_cleaning_strips_stray_symbols_keeps" android:textColor="@color/text_secondary" android:textSize="11.5sp" />
                        </LinearLayout>
                        <CheckBox android:id="@+id/cbUnwantedChars" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:checked="false" android:button="@drawable/checkbox_bevel" />
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:text="@string/data_cleaning_case_standardization_global" android:textAppearance="@style/TextAppearance.App.SectionTitle" android:textSize="13.5sp" />
                    <Spinner android:id="@+id/spinnerCaseMode" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:background="@drawable/bg_input_field" android:popupBackground="@drawable/bg_input_field" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:text="@string/data_cleaning_missing_values" android:textAppearance="@style/TextAppearance.App.SectionTitle" android:textSize="13.5sp" />
                    <Spinner android:id="@+id/spinnerMissingValues" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:background="@drawable/bg_input_field" android:popupBackground="@drawable/bg_input_field" />

                    <EditText android:importantForAutofill="no"
                        android:id="@+id/etFillMissing"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:background="@drawable/bg_input_field"
                        android:hint="@string/data_cleaning_fill_value_used_when" android:textColor="@color/text_primary" android:textSize="13sp"
                        android:inputType="text" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" android:layout_marginTop="16dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="10dp" android:paddingBottom="10dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/data_cleaning_fuzzy_match_when_de" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/data_cleaning_ignores_case_spacing_e" android:textColor="@color/text_secondary" android:textSize="11.5sp" />
                        </LinearLayout>
                        <CheckBox android:id="@+id/cbFuzzyDedupe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:button="@drawable/checkbox_bevel" />
                    </LinearLayout>

                    <EditText android:importantForAutofill="no"
                        android:id="@+id/etDedupeKeys"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:background="@drawable/bg_input_field"
                        android:hint="@string/data_cleaning_dedupe_by_columns_comma" android:textColor="@color/text_primary" android:textSize="13sp"
                        android:inputType="text" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" android:layout_marginTop="16dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="10dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/data_cleaning_flag_invalid_values" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/data_cleaning_auto_detects_email_phone" android:textColor="@color/text_secondary" android:textSize="11.5sp" />
                        </LinearLayout>
                        <CheckBox android:id="@+id/cbFlagInvalid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:checked="true" android:button="@drawable/checkbox_bevel" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClean"
                        style="@style/Widget.App.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/data_cleaning_clean_data" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STEP 2B — Data validation & normalization -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/data_cleaning_step_b" android:textAppearance="@style/TextAppearance.App.Eyebrow" android:layout_marginBottom="6dp" />

                    <LinearLayout android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_chip">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/dashboard_symbol_3" android:textSize="17sp" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/data_cleaning_data_validation_normalization" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/data_cleaning_emails_phones_dates_currency" android:textAppearance="@style/TextAppearance.App.Body" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/data_cleaning_when_a_value_fails" android:textAppearance="@style/TextAppearance.App.SectionTitle" android:textSize="13.5sp" />
                    <Spinner android:id="@+id/spinnerInvalidAction" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:background="@drawable/bg_input_field" android:popupBackground="@drawable/bg_input_field" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                        android:text="@string/data_cleaning_ambiguous_date_order_e" android:textAppearance="@style/TextAppearance.App.SectionTitle" android:textSize="13.5sp" />
                    <Spinner android:id="@+id/spinnerDateOrder" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:background="@drawable/bg_input_field" android:popupBackground="@drawable/bg_input_field" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                        android:text="@string/data_cleaning_yes_no_output_format" android:textAppearance="@style/TextAppearance.App.SectionTitle" android:textSize="13.5sp" />
                    <Spinner android:id="@+id/spinnerBooleanFormat" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:background="@drawable/bg_input_field" android:popupBackground="@drawable/bg_input_field" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" android:layout_marginTop="16dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="10dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/data_cleaning_catch_near_duplicate_rows" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/data_cleaning_similarity_match_beyond_exact" android:textColor="@color/text_secondary" android:textSize="11.5sp" />
                        </LinearLayout>
                        <CheckBox android:id="@+id/cbSimilarityDedupe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:button="@drawable/checkbox_bevel" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- OPTIONAL — Per-column rules -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">


                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/data_cleaning_optional" android:textAppearance="@style/TextAppearance.App.Eyebrow" android:layout_marginBottom="6dp" />

                    <LinearLayout android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_chip">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/data_cleaning_symbol_5" android:textSize="17sp" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/data_cleaning_per_column_rules" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/data_cleaning_override_the_global_settings" android:textAppearance="@style/TextAppearance.App.Body" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetectColumns"
                        style="@style/Widget.App.Button.Compact.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/data_cleaning_detect_columns" />

                    <LinearLayout
                        android:id="@+id/columnRulesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- OPTIONAL — Find & replace -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/data_cleaning_optional" android:textAppearance="@style/TextAppearance.App.Eyebrow" android:layout_marginBottom="6dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_chip">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/data_cleaning_symbol_6" android:textSize="17sp" />
                        </FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
                            android:text="@string/data_cleaning_find_replace_rules" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/replaceRulesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddReplaceRule"
                        style="@style/Widget.App.Button.Compact.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/data_cleaning_add_rule" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Results -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/data_cleaning_results" android:textAppearance="@style/TextAppearance.App.Eyebrow" android:layout_marginBottom="6dp" android:layout_marginStart="4dp" />
            <TextView
                android:id="@+id/tvReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_field"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp"
                android:lineSpacingExtra="3dp" />

            <!-- Output -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/data_cleaning_output" android:textAppearance="@style/TextAppearance.App.Eyebrow" android:layout_marginBottom="6dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_chip">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/data_cleaning_symbol_7" android:textSize="17sp" />
                        </FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
                            android:text="@string/data_cleaning_cleaned_output" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                    </LinearLayout>

                    <EditText android:importantForAutofill="no"
                        android:id="@+id/etOutput"
                        android:layout_width="match_parent"
                        android:layout_height="340dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_input_field_focused"
                        android:fontFamily="monospace"
                        android:gravity="top|start"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp"
                        android:inputType="textMultiLine" 
                        android:scrollbars="vertical"
                        android:overScrollMode="always"
                        android:scrollbarStyle="insideInset"
                        android:fadeScrollbars="false"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/data_cleaning_export_as" android:textAppearance="@style/TextAppearance.App.SectionTitle" android:textSize="13.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportCsv"
                            style="@style/Widget.App.Button.Compact.Outlined"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginEnd="4dp" android:enabled="false"
                            android:text="@string/data_cleaning_csv" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportXlsx"
                            style="@style/Widget.App.Button.Compact.Outlined"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:enabled="false"
                            android:text="@string/data_cleaning_xlsx" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportJson"
                            style="@style/Widget.App.Button.Compact.Outlined"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:enabled="false"
                            android:text="@string/data_cleaning_json" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportTxt"
                            style="@style/Widget.App.Button.Compact.Outlined"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="4dp" android:enabled="false"
                            android:text="@string/data_cleaning_txt" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
