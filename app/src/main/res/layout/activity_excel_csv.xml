<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately a plain vertical LinearLayout, not a ScrollView, at the root: the grid below
     needs to own its own two-directional scroll/fling gestures, which fight with an ancestor
     ScrollView's vertical scroll if nested inside one. Everything except the grid is
     wrap_content/fixed height; the grid takes whatever's left via layout_weight="1". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_flat"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="26dp" android:paddingBottom="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/excel_csv_excel_csv" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="@string/excel_csv_open_edit_cells_and" android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="12dp" android:paddingBottom="8dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickXlsx"
                style="@style/Widget.App.Button.Compact"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:text="@string/excel_csv_open_xlsx" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickCsv"
                style="@style/Widget.App.Button.Compact.Outlined"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" android:text="@string/excel_csv_open_csv" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:progressTint="@color/accent_excel"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/excel_csv_open_a_file_or"
            android:textColor="@color/text_secondary" android:textSize="12.5sp" />

        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:fillViewport="false">
            <LinearLayout
                android:id="@+id/sheetTabsContainer"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvCellRef"
                android:layout_width="52dp" android:layout_height="wrap_content"
                android:text="@string/excel_csv_a" android:textColor="@color/accent_excel" android:textStyle="bold"
                android:textSize="13sp" android:fontFamily="monospace" android:gravity="center" />
            <TextView
                android:id="@+id/btnBold"
                android:layout_width="36dp" android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="@string/excel_csv_b" android:textColor="@color/text_secondary" android:textStyle="bold"
                android:textSize="15sp" android:gravity="center"
                android:background="@drawable/bg_pill_muted"
                android:clickable="true" android:focusable="true" />
            <EditText android:importantForAutofill="no"
                android:id="@+id/formulaBar"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="monospace" android:textSize="14sp" android:textColor="@color/text_primary"
                android:hint="@string/excel_csv_cell_value_or_formula"
                android:inputType="text" android:imeOptions="actionDone" android:maxLines="1"
                android:paddingTop="8dp" android:paddingBottom="8dp" />
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" />

    <com.prateek.datatoolkit.features.excel.SpreadsheetGridView
        android:id="@+id/spreadsheetGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportCsv"
                style="@style/Widget.App.Button.Compact"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:text="@string/excel_csv_save_csv" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportXlsx"
                style="@style/Widget.App.Button.Compact.Outlined"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" android:text="@string/excel_csv_save_xlsx" />
        </LinearLayout>
        <!-- Overwrites the opened file in place; disabled until a file's actually been opened
             (there's nothing to overwrite for the blank starter sheet). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdate"
            style="@style/Widget.App.Button.Compact.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/excel_csv_update_opened_file" android:enabled="false" />
    </LinearLayout>
</LinearLayout>
