<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_flat"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_icon_chip_on_primary">
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_brand_mark_white"
                            android:contentDescription="@string/app_name" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Data Toolkit"
                            android:textColor="@color/text_on_primary"
                            android:textAppearance="@style/TextAppearance.App.HeroTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="OCR, PDF, Excel/CSV, scraping and more — all on-device."
                            android:textColor="@color/text_on_primary_muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Workflow is the newest capability, so it gets top billing here instead
                     of sitting as just another row in the grid below. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWorkflow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    style="@style/Widget.App.Button.Workflow"
                    android:text="🔀  Build a Workflow — chain tools together" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="center_horizontal"
                    android:text="✨ New — turn several tools into one automatic pipeline"
                    android:textColor="@color/text_on_primary_muted"
                    android:textSize="11.5sp" />

            </LinearLayout>
        </FrameLayout>

        <!-- Tool grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOOLS"
                android:textAppearance="@style/TextAppearance.App.Eyebrow"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="4dp" />

            <!-- Row 1: Data Cleaning / OCR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnCleaning"
                    style="@style/Widget.App.Card.Feature"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginEnd="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/accent_cleaning_bg">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="🧹" android:textSize="19sp" />
                        </FrameLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                            android:text="Data Cleaning" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp"
                            android:text="Trim, dedupe, export" android:textAppearance="@style/TextAppearance.App.Body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnOcr"
                    style="@style/Widget.App.Card.Feature"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginStart="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/accent_ocr_bg">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="🔍" android:textSize="19sp" />
                        </FrameLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                            android:text="OCR" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp"
                            android:text="Scanned documents" android:textAppearance="@style/TextAppearance.App.Body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 2: PDF / Excel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnPdf"
                    style="@style/Widget.App.Card.Feature"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginEnd="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/accent_pdf_bg">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="📄" android:textSize="19sp" />
                        </FrameLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                            android:text="PDF Tools" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp"
                            android:text="Merge, split, extract" android:textAppearance="@style/TextAppearance.App.Body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnExcel"
                    style="@style/Widget.App.Card.Feature"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginStart="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/accent_excel_bg">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="📊" android:textSize="19sp" />
                        </FrameLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                            android:text="Excel / CSV" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp"
                            android:text="Open, preview, convert" android:textAppearance="@style/TextAppearance.App.Body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 3: Web Scraping / Email Extraction -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnScraping"
                    style="@style/Widget.App.Card.Feature"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginEnd="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/accent_scraping_bg">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="🌐" android:textSize="19sp" />
                        </FrameLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                            android:text="Web Scraping" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp"
                            android:text="Auto-detect &amp; export" android:textAppearance="@style/TextAppearance.App.Body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnEmail"
                    style="@style/Widget.App.Card.Feature"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginStart="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/accent_email_bg">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="✉️" android:textSize="19sp" />
                        </FrameLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                            android:text="Email Extraction" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp"
                            android:text="Pull &amp; validate emails" android:textAppearance="@style/TextAppearance.App.Body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 4: Batch Processing / Analytics Dashboard -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnBatch"
                    style="@style/Widget.App.Card.Feature"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginEnd="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/accent_batch_bg">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="⚡" android:textSize="19sp" />
                        </FrameLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                            android:text="Batch Processing" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp"
                            android:text="Background OCR/PDF jobs" android:textAppearance="@style/TextAppearance.App.Body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnDashboard"
                    style="@style/Widget.App.Card.Feature"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginStart="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/accent_dashboard_bg">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="📈" android:textSize="19sp" />
                        </FrameLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                            android:text="Analytics" android:textAppearance="@style/TextAppearance.App.SectionTitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp"
                            android:text="Totals, quality, activity" android:textAppearance="@style/TextAppearance.App.Body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
