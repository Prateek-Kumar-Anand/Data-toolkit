<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup/transfer rules. toolkit_cache.db (see AppDatabase) stores a
  history of everything every tool has processed, including up to 500 characters of the actual
  output text (see CacheManager.record) - OCR'd document/receipt text, scraped page content,
  extracted emails/phone numbers, cleaned data previews. That's the user's own processed
  content, not app config, so it's excluded from both cloud backup and device-to-device
  transfer rather than silently leaving the device without the user having asked for that.
  Everything else this app writes (exported files, temp copies) already lives under the cache
  dir, which Android's Auto Backup never includes regardless of these rules.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="toolkit_cache.db" />
        <exclude domain="database" path="toolkit_cache.db-wal" />
        <exclude domain="database" path="toolkit_cache.db-shm" />
        <exclude domain="database" path="toolkit_cache.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="toolkit_cache.db" />
        <exclude domain="database" path="toolkit_cache.db-wal" />
        <exclude domain="database" path="toolkit_cache.db-shm" />
        <exclude domain="database" path="toolkit_cache.db-journal" />
    </device-transfer>
</data-extraction-rules>
