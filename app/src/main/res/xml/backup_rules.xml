<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 (API 24-30) equivalent of data_extraction_rules.xml - see the comment there for
  why toolkit_cache.db is excluded. Android ignores this file on API 31+ in favor of
  dataExtractionRules, and ignores dataExtractionRules below that, so both are kept in sync.
-->
<full-backup-content>
    <exclude domain="database" path="toolkit_cache.db" />
    <exclude domain="database" path="toolkit_cache.db-wal" />
    <exclude domain="database" path="toolkit_cache.db-shm" />
    <exclude domain="database" path="toolkit_cache.db-journal" />
</full-backup-content>
