<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, and only the system trust store (no user-installed CAs) so a rogue
         certificate can't be used to read scraped traffic. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
