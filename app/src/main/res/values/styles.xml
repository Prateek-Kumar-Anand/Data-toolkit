<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Primary push-button: brass, domed bevel, presses in on touch. Custom
         android:background carries all the visual richness, so backgroundTint
         is explicitly nulled - MaterialButton's default tint would otherwise
         recolour every layer of that drawable flat, erasing the bevel. -->
    <style name="Widget.App.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/btn_bevel_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="rippleColor">@color/ripple_on_primary</item>
        <item name="elevation">3dp</item>
    </style>

    <!-- Copper-red indicator-lamp button, for standout actions -->
    <style name="Widget.App.Button.Accent" parent="Widget.App.Button.Primary">
        <item name="android:background">@drawable/btn_bevel_accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">#40FFFFFF</item>
    </style>

    <!-- Plum CTA button - used for the Workflow entry points, so that module
         still stands out next to the app's usual brass buttons. -->
    <style name="Widget.App.Button.Workflow" parent="Widget.App.Button.Primary">
        <item name="android:background">@drawable/btn_bevel_workflow</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">#40FFFFFF</item>
    </style>

    <!-- Jade CTA button - same "hero" treatment as Workflow, for the other newest feature. -->
    <style name="Widget.App.Button.Invoice" parent="Widget.App.Button.Primary">
        <item name="android:background">@drawable/btn_bevel_invoice</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">#40FFFFFF</item>
    </style>

    <!-- Destructive action -->
    <style name="Widget.App.Button.Danger" parent="Widget.App.Button.Primary">
        <item name="android:background">@drawable/btn_bevel_danger</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">#40FFFFFF</item>
    </style>

    <!-- Engraved-plate button for secondary navigation actions -->
    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:background">@drawable/btn_bevel_outlined</item>
        <item name="backgroundTint">@null</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="rippleColor">@color/icon_chip_bg</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <!-- A compact version for half-width button pairs -->
    <style name="Widget.App.Button.Compact" parent="Widget.App.Button.Primary">
        <item name="android:textSize">13.5sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="Widget.App.Button.Compact.Outlined" parent="Widget.App.Button.Outlined">
        <item name="android:textSize">13.5sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Elevated brushed-metal panel used to group a section of a screen -->
    <style name="Widget.App.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
        <item name="rippleColor">@color/icon_chip_bg</item>
    </style>

    <!-- Clickable feature-list panel on the dashboard -->
    <style name="Widget.App.Card.Feature" parent="Widget.App.Card">
        <item name="cardElevation">1dp</item>
        <item name="rippleColor">@color/icon_chip_bg</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Large title on a gunmetal header (hero card, feature screen headers).
         Condensed + tracked like a lettered nameplate stamped into the panel. -->
    <style name="TextAppearance.App.HeroTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Section eyebrow label, e.g. "STEP 1" - reads like an engraved panel label -->
    <style name="TextAppearance.App.Eyebrow" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.App.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">16.5sp</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- Digital-readout style for stat numbers/counters - like an instrument's
         LED/LCD display. Monospace is a guaranteed system font family, so this
         needs no fallback handling. -->
    <style name="TextAppearance.App.Readout" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Gauge-style progress bar - recessed groove track, brass fill. Applied
         app-wide via the android:progressBarStyleHorizontal theme override
         below, since every screen's ProgressBar already references that
         platform style attribute rather than a custom one. The indeterminate
         (spinner) instances keep the platform's own tested animation and are
         just retinted to brass, rather than replaced with a custom animated
         drawable that can't be visually verified here. -->
    <style name="Widget.App.ProgressBar.Horizontal" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_bevel_horizontal</item>
        <item name="android:indeterminateTint">@color/primary</item>
        <item name="android:minHeight">10dp</item>
        <item name="android:maxHeight">10dp</item>
    </style>

</resources>
