<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Primary filled action button: rounded pill, brand color, subtle elevation -->
    <style name="Widget.App.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="rippleColor">@color/ripple_on_primary</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- Secondary / amber accent button, for standout actions -->
    <style name="Widget.App.Button.Accent" parent="Widget.App.Button.Primary">
        <item name="backgroundTint">@color/accent</item>
    </style>

    <!-- Fuchsia CTA button - used for the Workflow entry points, so the newest feature
         stands out at a glance next to the app's usual indigo buttons. -->
    <style name="Widget.App.Button.Workflow" parent="Widget.App.Button.Primary">
        <item name="backgroundTint">@color/accent_workflow</item>
    </style>

    <!-- Teal CTA button - same "hero" treatment as Workflow, for the other newest feature. -->
    <style name="Widget.App.Button.Invoice" parent="Widget.App.Button.Primary">
        <item name="backgroundTint">@color/accent_invoice</item>
    </style>

    <!-- Destructive action -->
    <style name="Widget.App.Button.Danger" parent="Widget.App.Button.Primary">
        <item name="backgroundTint">@color/error</item>
    </style>

    <!-- Outlined button for secondary navigation actions -->
    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="rippleColor">@color/icon_chip_bg</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <!-- A compact version for half-width button pairs -->
    <style name="Widget.App.Button.Compact" parent="Widget.App.Button.Primary">
        <item name="android:textSize">13.5sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.App.Button.Compact.Outlined" parent="Widget.App.Button.Outlined">
        <item name="android:textSize">13.5sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Elevated content card used to group a section of a screen -->
    <style name="Widget.App.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
        <item name="rippleColor">@color/icon_chip_bg</item>
    </style>

    <!-- Clickable feature-list card on the dashboard -->
    <style name="Widget.App.Card.Feature" parent="Widget.App.Card">
        <item name="cardElevation">0dp</item>
        <item name="rippleColor">@color/icon_chip_bg</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Large title on a gradient header (hero card, feature screen headers). Medium
         weight + slightly tightened tracking reads a bit more refined at this size than
         the system default bold, while staying legible against the colored backdrop. -->
    <style name="TextAppearance.App.HeroTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Section eyebrow label, e.g. "STEP 1" -->
    <style name="TextAppearance.App.Eyebrow" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.App.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

</resources>
